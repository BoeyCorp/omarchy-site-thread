def build_cloud_summary(key: str) -> dict[str, Any]:
    raw_sites = cloud_rows(key, "/v1/sites")
    if len(raw_sites) > MAX_MODEL_ITEMS:
        raise FabricError("UniFi Site Manager returned too many sites")
    try:
        raw_hosts = cloud_rows(key, "/v1/hosts")
    except FabricError:
        raw_hosts = []
    try:
        raw_groups = cloud_rows(key, "/v1/devices")
    except FabricError:
        raw_groups = []

    host_names: dict[str, str] = {}
    host_online = {
        model_string(first_value(host, "id", "hostId"), max_length=256): host_is_online(host)
        for host in raw_hosts
        if first_value(host, "id", "hostId")
    }
    flattened: list[dict[str, Any]] = []
    for group in raw_groups:
        host_id = model_string(first_value(group, "hostId", "id"), max_length=256)
        host_name = model_string(first_value(group, "hostName", "name"))
        if host_id and host_name:
            host_names[host_id] = host_name
        members = group.get("devices")
        if isinstance(members, list):
            for member in members:
                if isinstance(member, dict):
                    copy = dict(member)
                    copy.setdefault("hostId", host_id)
                    copy.setdefault("hostName", host_name)
                    flattened.append(copy)
        else:
            flattened.append(group)
        if len(flattened) > MAX_MODEL_ITEMS:
            raise FabricError("UniFi Site Manager returned too many devices")

    sites: list[dict[str, Any]] = []
    total_devices = total_clients = total_offline = total_updates = 0
    for item in raw_sites:
        meta = item.get("meta") if isinstance(item.get("meta"), dict) else {}
        stats = item.get("statistics") if isinstance(item.get("statistics"), dict) else {}
        counts = stats.get("counts") if isinstance(stats.get("counts"), dict) else {}
        percentages = stats.get("percentages") if isinstance(stats.get("percentages"), dict) else {}
        isp_info = stats.get("ispInfo") if isinstance(stats.get("ispInfo"), dict) else {}
        host_id = model_string(first_value(item, "hostId"), max_length=256)
        raw_name = model_string(first_value(meta, "desc", "name", default="Site"))
        name = host_names.get(host_id, raw_name) if raw_name.lower() == "default" else raw_name
        device_count = int(nested_number(counts, "totalDevice"))
        client_count = int(sum(nested_number(counts, key) for key in ("wifiClient", "wiredClient", "guestClient")))
        wifi_count = int(nested_number(counts, "wifiClient"))
        wired_count = int(nested_number(counts, "wiredClient"))
        offline_count = int(nested_number(counts, "offlineDevice"))
        update_count = int(nested_number(counts, "pendingUpdateDevice"))
        total_devices += device_count
        total_clients += client_count
        total_offline += offline_count
        total_updates += update_count
        status, status_text = site_health(stats, counts)
        if host_id in host_online and not host_online[host_id]:
            status, status_text = "down", "Site unreachable"
        lat, lng = site_coordinates(meta, model_string(first_value(meta, "timezone"), max_length=128), len(sites))

        site_devs = [
            d for d in flattened
            if model_string(first_value(d, "hostId", "id"), max_length=256) == host_id
            or model_string(first_value(d, "hostName", "name")) == name
            or str(d.get("site", "")).casefold() == name.casefold()
        ]
        gw_item = next(
            (d for d in site_devs if any(k in str(d.get("model", "")).lower() for k in ("udm", "ucg", "uxg", "gateway", "usg"))),
            None
        )
        gw_model = model_string(first_value(gw_item, "model", "shortname", "type")) if gw_item else ""
        gw_ip = model_string(first_value(gw_item, "ipAddress", "ip", "lanIp"), max_length=64) if gw_item else ""

        sites.append({
            "id": model_string(first_value(item, "siteId", "id"), max_length=128),
            "hostId": host_id,
            "name": name,
            "isp": model_string(first_value(isp_info, "name", "organization")),
            "timezone": model_string(first_value(meta, "timezone"), max_length=128),
            "lat": lat,
            "lng": lng,
            "gatewayModel": gw_model,
            "gatewayIp": gw_ip,
            "deviceCount": device_count,
            "clientCount": client_count,
            "wifiClients": wifi_count,
            "wiredClients": wired_count,
            "offlineCount": offline_count,
            "updateCount": update_count,
            "wanUptime": nested_number(percentages, "wanUptime"),
            "permission": model_string(first_value(item, "permission", default="viewer"), max_length=64),
            "owner": bool(item.get("isOwner", False)),
            "status": status,
            "statusText": status_text,
        })

    sites.sort(key=site_sort_key)

    devices = [compact_device(item) | {"site": model_string(first_value(item, "hostName"))} for item in flattened]
    camera_words = ("camera", "protect", "doorbell", "ai pro", "g3", "g4", "g5", "uvc")
    camera_items = [
        item for item in flattened
        if any(word in " ".join(str(value).lower() for value in item.values() if isinstance(value, (str, int))) for word in camera_words)
    ]
    cameras = [compact_camera(item) for item in camera_items]
    if not total_devices and devices:
        total_devices = len(devices)
        total_offline = sum(not item["online"] for item in devices)
        total_updates = sum(item["update"] for item in devices)

    down_sites = sum(item["status"] == "down" for item in sites)
    backup_sites = sum(item["status"] == "backup" for item in sites)
    if down_sites:
        severity, message = "critical", f"{down_sites} site(s) unreachable"
    elif backup_sites:
        severity, message = "warning", f"{backup_sites} site(s) using backup WAN"
    elif total_offline:
        severity, message = "critical", f"{total_offline} device(s) offline across {len(sites)} sites"
    elif total_updates:
        severity, message = "warning", f"{total_updates} firmware update(s) across {len(sites)} sites"
    else:
        severity, message = "healthy", f"All {len(sites)} sites operational"

    total_wifi = sum(s.get("wifiClients", 0) for s in sites)
    total_wired = sum(s.get("wiredClients", 0) for s in sites)
    total_gateways = sum(bool(s.get("gatewayModel")) for s in sites)
    issues = track_issues(sites, devices, is_demo=False)

    return {
        "ok": True,
        "connected": True,
        "mode": "cloud",
        "baseUrl": "https://unifi.ui.com",
        "host": "unifi.ui.com",
        "site": f"{len(sites)} site" + ("" if len(sites) == 1 else "s"),
        "sites": sites,
        "severity": severity,
        "message": message,
        "network": {
            "available": True,
            "devices": devices,
            "deviceCount": total_devices,
            "offlineCount": total_offline,
            "updateCount": total_updates,
            "clientCount": total_clients,
            "wifiClients": total_wifi,
            "wiredClients": total_wired,
            "gatewaysCount": total_gateways,
        },
        "protect": {"available": bool(cameras), "cameras": cameras, "cameraCount": len(cameras), "offlineCount": sum(not item["online"] for item in cameras)},
        "issues": issues,
    }


def build_cloud_site(key: str, host_id: str, site_id: str) -> dict[str, Any]:
    if not ID_PATTERN.fullmatch(site_id):
        raise FabricError("Invalid UniFi site id")

    site_status, sites_payload = cloud_json_request(key, connector_path(host_id, "/network/integration/v1/sites"))
    if site_status != 200:
        raise FabricError(f"This site's Network application is unavailable (HTTP {site_status})")
    network_sites = rows(sites_payload)
    chosen = next(
        (item for item in network_sites if model_string(first_value(item, "id", "siteId", "_id"), max_length=128) == site_id),
        network_sites[0] if len(network_sites) == 1 else None,
    )
    if not chosen:
        raise FabricError("UniFi Cloud Connector could not match this Network site")
    local_site_id = model_string(first_value(chosen, "id", "siteId", "_id"), max_length=128)
    if not ID_PATTERN.fullmatch(local_site_id):
        raise FabricError("The console returned an invalid Network site id")

    device_status, device_payload = cloud_json_request(
        key, connector_path(host_id, f"/network/integration/v1/sites/{local_site_id}/devices")
    )
    client_status, client_payload = cloud_json_request(
        key, connector_path(host_id, f"/network/integration/v1/sites/{local_site_id}/clients")
    )
    devices = [compact_device(item) for item in rows(device_payload)] if device_status == 200 else []
    clients = rows(client_payload) if client_status == 200 else []

    protect_status, protect_payload = cloud_json_request(
        key, connector_path(host_id, "/protect/integration/v1/cameras")
    )
    protect_installed = protect_status == 200
    cameras = [compact_camera(item) for item in rows(protect_payload)] if protect_installed else []
    offline_devices = sum(not item["online"] for item in devices)
    offline_cameras = sum(not item["online"] for item in cameras)
    updates = sum(item["update"] for item in devices)
    return {
        "ok": True,
        "connected": True,
        "mode": "cloud-site",
        "hostId": host_id,
        "siteId": site_id,
        "site": {
            "id": local_site_id,
            "name": model_string(first_value(chosen, "name", "displayName", default="UniFi site")),
        },
        "network": {
            "available": True,
            "devices": devices,
            "deviceCount": len(devices),
            "offlineCount": offline_devices,
            "updateCount": updates,
            "clientCount": len(clients),
        },
        "protect": {
            "installed": protect_installed,
            "available": protect_installed,
            "cameras": cameras,
            "cameraCount": len(cameras),
            "offlineCount": offline_cameras,
        },
    }


def build_summary(config: dict[str, Any], key: str) -> dict[str, Any]:
    network_status, sites_payload = json_request(config, key, "/proxy/network/integration/v1/sites")
    protect_status, cameras_payload = json_request(config, key, "/proxy/protect/integration/v1/cameras")

    sites = rows(sites_payload) if network_status == 200 else []
    site = sites[0] if sites else {}
    site_id = model_string(first_value(site, "id", "siteId", "_id"), max_length=128)
    devices: list[dict[str, Any]] = []
    clients: list[dict[str, Any]] = []
    if site_id:
        device_status, device_payload = json_request(config, key, f"/proxy/network/integration/v1/sites/{site_id}/devices")
        client_status, client_payload = json_request(config, key, f"/proxy/network/integration/v1/sites/{site_id}/clients")
        if device_status == 200:
            devices = [compact_device(item) for item in rows(device_payload)]
        if client_status == 200:
            clients = rows(client_payload)

    cameras = [compact_camera(item) for item in rows(cameras_payload)] if protect_status == 200 else []
    offline_devices = sum(not item["online"] for item in devices)
    offline_cameras = sum(not item["online"] for item in cameras)
    updates = sum(item["update"] for item in devices)

    available_apps = int(network_status == 200) + int(protect_status == 200)
    if available_apps == 0:
        raise FabricError("The API key was accepted by neither Network nor Protect")
    if offline_devices + offline_cameras:
        severity, message = "critical", f"{offline_devices + offline_cameras} device(s) offline"
    elif available_apps < 2:
        severity, message = "warning", "One UniFi application is unavailable"
    elif updates:
        severity, message = "warning", f"{updates} firmware update(s) available"
    else:
        severity, message = "healthy", "All systems operational"

    return {
        "ok": True,
        "connected": True,
        "baseUrl": config["baseUrl"],
        "host": config["hostname"],
        "site": model_string(first_value(site, "name", "displayName", default="Default")),
        "severity": severity,
        "message": message,
        "network": {
            "available": network_status == 200,
            "devices": devices,
            "deviceCount": len(devices),
            "offlineCount": offline_devices,
            "updateCount": updates,
            "clientCount": len(clients),
        },
        "protect": {
            "available": protect_status == 200,
            "cameras": cameras,
            "cameraCount": len(cameras),
            "offlineCount": offline_cameras,
        },
        "issues": track_issues([], devices, is_demo=False),
    }


def command_clear_history() -> None:
    if ISSUES_FILE.is_file():
        try:
            raw = decode_json(ISSUES_FILE.read_text(encoding="utf-8"))
            if isinstance(raw, list):
                active = [i for i in raw if isinstance(i, dict) and i.get("active")]
                ISSUES_FILE.write_text(json.dumps(active, separators=(",", ":")), encoding="utf-8")
        except Exception:
            ISSUES_FILE.unlink(missing_ok=True)
    emit({"ok": True, "cleared": True})


def command_probe(raw_host: str) -> None:
    base_url, hostname, port = normalize_host(raw_host)
    pem = fetch_certificate(hostname, port)
    fingerprint, spki = certificate_identity(pem)
    saved = read_config()
    emit({
        "ok": True,
        "baseUrl": base_url,
        "host": hostname,
        "port": port,
        "fingerprint": fingerprint,
        "trusted": bool(saved and saved.get("spki") == spki),
    })


def command_connect(raw_host: str, accepted_fingerprint: str) -> None:
    key = sys.stdin.readline().strip()
    if not KEY_PATTERN.fullmatch(key):
        fail("Enter a valid UniFi API key")
    base_url, hostname, port = normalize_host(raw_host)
    pem = fetch_certificate(hostname, port)
    fingerprint, spki = certificate_identity(pem)
    if fingerprint != accepted_fingerprint.strip().upper():
        fail("The console certificate changed; inspect it again before connecting")
    candidate = {
        "baseUrl": base_url,
        "hostname": hostname,
        "port": port,
        "fingerprint": fingerprint,
        "spki": spki,
    }
    # Validate before persisting either the connection or the credential.
    try:
        summary = build_summary(candidate, key)
    except FabricError as exc:
        fail(str(exc))
    secret_store(key)
    write_config(candidate)
    summary["authenticated"] = True
    emit(summary)


def command_connect_cloud() -> None:
    key = sys.stdin.readline().strip()
    if not KEY_PATTERN.fullmatch(key):
        fail("Enter a valid UI Account API key")
    try:
        summary = build_cloud_summary(key)
    except FabricError as exc:
        fail(str(exc))
    secret_store(key)
    write_config({"mode": "cloud", "baseUrl": "https://api.ui.com"})
    summary["authenticated"] = True
    emit(summary)


def command_summary(demo: bool) -> None:
    if demo:
        emit(demo_summary())
    config = read_config()
    key = secret_lookup()
    if not config or not key:
        fail("Connect UniFi SiteThread to your UI Account", connected=False)
    try:
        emit(build_cloud_summary(key) if config.get("mode") == "cloud" else build_summary(config, key))
    except FabricError as exc:
        fail(str(exc), connected=True)


def command_site(host_id: str, site_id: str) -> None:
    config = read_config()
    key = secret_lookup()
    if not config or not key:
        fail("UniFi SiteThread is not connected", connected=False)
    if config.get("mode") != "cloud":
        fail("Site drill-down is available for UI Account connections")
    try:
        emit(build_cloud_site(key, host_id, site_id))
    except FabricError as exc:
        fail(str(exc), connected=True)


def command_snapshot(camera_id: str, host_id: str | None) -> None:
    if not ID_PATTERN.fullmatch(camera_id):
        fail("Invalid camera id")
    config = read_config()
    key = secret_lookup()
    if not config or not key:
        fail("UniFi SiteThread is not connected", connected=False)
    private_dir(RUNTIME_DIR)
    target = RUNTIME_DIR / f"camera-{camera_id}-{os.getpid()}.jpg"
    if config.get("mode") == "cloud":
        if not host_id:
            fail("A site is required for a cloud camera")
        status = cloud_file_request(
            key,
            connector_path(host_id, f"/protect/integration/v1/cameras/{camera_id}/snapshot"),
            target,
        )
    else:
        status, _ = api_request(config, key, f"/proxy/protect/integration/v1/cameras/{camera_id}/snapshot", output=target)
    if status != 200 or not target.exists() or target.stat().st_size == 0:
        target.unlink(missing_ok=True)
        fail(f"Snapshot failed (HTTP {status})")
    target.chmod(0o600)
    emit({"ok": True, "path": str(target)})


def command_disconnect() -> None:
    secret_clear()
    CONFIG_FILE.unlink(missing_ok=True)
    LEGACY_CONFIG_FILE.unlink(missing_ok=True)
    emit({"ok": True, "connected": False})


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="site-thread")
    sub = parser.add_subparsers(dest="command", required=True)
    probe = sub.add_parser("probe")
    probe.add_argument("host")
    connect = sub.add_parser("connect")
    connect.add_argument("host")
    connect.add_argument("fingerprint")
    sub.add_parser("connect-cloud")
    summary = sub.add_parser("summary")
    summary.add_argument("--demo", action="store_true")
    site = sub.add_parser("site")
    site.add_argument("host_id")
    site.add_argument("site_id")
    snapshot = sub.add_parser("snapshot")
    snapshot.add_argument("camera_id")
    snapshot.add_argument("host_id", nargs="?")
    sub.add_parser("clear-history")
    sub.add_parser("disconnect")
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    try:
        if args.command == "probe":
            command_probe(args.host)
        elif args.command == "connect":
            command_connect(args.host, args.fingerprint)
        elif args.command == "connect-cloud":
            command_connect_cloud()
        elif args.command == "summary":
            command_summary(args.demo)
        elif args.command == "site":
            command_site(args.host_id, args.site_id)
        elif args.command == "snapshot":
            command_snapshot(args.camera_id, args.host_id)
        elif args.command == "clear-history":
            command_clear_history()
        elif args.command == "disconnect":
            command_disconnect()
    except FabricError as exc:
        fail(str(exc))


if __name__ == "__main__":
    main()
