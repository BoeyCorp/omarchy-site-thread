def get_sdwan_telemetry(key: str) -> dict[str, Any]:
    try:
        status, payload = cloud_json_request(key, "/v1/sd-wan-configs")
        if status != 200 or not isinstance(payload, dict):
            return {"available": False, "status": "none"}
        configs = payload.get("data", [])
        if not isinstance(configs, list) or not configs:
            return {"available": False, "status": "none"}

        cfg = configs[0]
        cfg_id = model_string(cfg.get("id", ""), max_length=128)
        cfg_name = model_string(cfg.get("name", "Site Magic SD-WAN"))
        cfg_type = model_string(cfg.get("type", "s2s-vpn"))

        detail_status, detail = cloud_json_request(key, f"/v1/sd-wan-configs/{cfg_id}")
        st_status, st_payload = cloud_json_request(key, f"/v1/sd-wan-configs/{cfg_id}/status")

        sites_list: list[dict[str, Any]] = []
        if detail_status == 200 and isinstance(detail, dict) and isinstance(detail.get("data"), dict):
            hosts = detail["data"].get("hosts", [])
            for h in hosts:
                h_name = model_string(h.get("hostName", "Site"))
                for s in h.get("sites", []):
                    for net in s.get("networks", []):
                        sites_list.append({
                            "name": h_name,
                            "subnet": model_string(net.get("subnet", "")),
                            "networkName": model_string(net.get("networkName", "")),
                        })

        connections: list[dict[str, Any]] = []
        is_connected = True
        ping_ms = 0
        if st_status == 200 and isinstance(st_payload, dict) and isinstance(st_payload.get("data"), dict):
            conns = st_payload["data"].get("status", {}).get("connections", [])
            for c in conns:
                pair_sites = c.get("sites", [])
                if len(pair_sites) >= 2:
                    st1 = pair_sites[0].get("status", {})
                    st2 = pair_sites[1].get("status", {})
                    conn_ok = bool(st1.get("connected") and st2.get("connected"))
                    if not conn_ok:
                        is_connected = False
                    ping_ms = max(int(st1.get("ping", 0)), int(st2.get("ping", 0)))
                    s1_name = sites_list[0]["name"] if len(sites_list) > 0 else "Site A"
                    s1_sub = sites_list[0]["subnet"] if len(sites_list) > 0 else ""
                    s2_name = sites_list[1]["name"] if len(sites_list) > 1 else "Site B"
                    s2_sub = sites_list[1]["subnet"] if len(sites_list) > 1 else ""
                    connections.append({
                        "siteA": s1_name,
                        "subnetA": s1_sub,
                        "siteB": s2_name,
                        "subnetB": s2_sub,
                        "connected": conn_ok,
                        "ping": ping_ms,
                    })

        return {
            "available": True,
            "id": cfg_id,
            "name": cfg_name,
            "type": cfg_type,
            "status": "connected" if is_connected else "degraded",
            "ping": ping_ms,
            "siteCount": len(sites_list),
            "sites": sites_list,
            "connections": connections,
        }
    except Exception:
        return {"available": False, "status": "none"}


def format_uptime(seconds: int) -> str:
    if seconds <= 0:
        return "0s"
    days = seconds // 86400
    hours = (seconds % 86400) // 3600
    minutes = (seconds % 3600) // 60
    if days > 0:
        return f"{days}d {hours}h"
    if hours > 0:
        return f"{hours}h {minutes}m"
    return f"{minutes}m"


def compact_console(host: dict[str, Any], site_name: str = "") -> dict[str, Any]:
    hid = model_string(first_value(host, "id", "hostId"), max_length=256)
    rep = host.get("reportedState") if isinstance(host.get("reportedState"), dict) else {}
    hw = rep.get("hardware") if isinstance(rep.get("hardware"), dict) else {}
    h_name = model_string(rep.get("name") or host.get("name") or site_name or hw.get("name") or "UniFi Console")
    model_name = model_string(hw.get("name") or hw.get("shortname") or "UniFi Console")
    direct_domain = model_string(rep.get("directConnectDomain") or host.get("directConnectDomain", ""))
    direct_url = f"https://{direct_domain}" if direct_domain else ""
    web_url = f"https://unifi.ui.com/consoles/{hid}" if hid else "https://unifi.ui.com"
    local_ip = model_string(rep.get("ip") or (rep.get("ipAddrs") and rep.get("ipAddrs")[0]) or host.get("ipAddress") or "")
    local_url = f"https://{local_ip}" if local_ip else ""
    firmware = model_string(rep.get("version") or hw.get("firmwareVersion") or "")
    mac = model_string(hw.get("mac") or rep.get("mac") or "")
    is_online = host_is_online(host)

    app_display_names = {
        "network": "UniFi Network",
        "protect": "UniFi Protect",
        "innerspace": "UniFi InnerSpace",
        "drive": "UniFi Drive",
        "access": "UniFi Access",
        "talk": "UniFi Talk",
        "connect": "UniFi Connect",
        "users": "UniFi Identity / Users",
        "id": "UniFi Identity",
    }
    app_icons = {
        "network": "network",
        "protect": "video",
        "innerspace": "cube",
        "drive": "hard-drive",
        "access": "id-badge",
        "talk": "phone",
        "connect": "tv",
        "users": "users",
        "id": "users",
    }

    apps_list: list[dict[str, Any]] = []
    raw_controllers = rep.get("controllers") if isinstance(rep.get("controllers"), list) else []
    raw_apps = rep.get("apps") if isinstance(rep.get("apps"), list) else []

    seen_app_ids = set()
    for c in raw_controllers:
        if not isinstance(c, dict):
            continue
        app_id = model_string(c.get("name", "")).lower()
        if not app_id or app_id in seen_app_ids:
            continue
        seen_app_ids.add(app_id)
        ver = model_string(c.get("version") or c.get("uiVersion") or "")
        is_active = (c.get("state") == "active" or c.get("isRunning") is True or bool(ver)) and c.get("state") != "inactive"
        is_installed = bool(c.get("isInstalled", True)) or is_active
        upd_avail = model_string(c.get("updateAvailable", "")) if c.get("updateAvailable") else ""
        apps_list.append({
            "id": app_id,
            "name": app_display_names.get(app_id, f"UniFi {app_id.capitalize()}"),
            "version": ver if ver else ("Installed" if is_installed else "Available"),
            "state": "active" if is_active else ("inactive" if not is_installed else "stopped"),
            "isRunning": is_active,
            "isInstalled": is_installed,
            "updatable": bool(c.get("updatable", False)),
            "updateAvailable": upd_avail,
            "port": int(c.get("port") or 0),
            "icon": app_icons.get(app_id, "cube"),
            "directUrl": f"https://{direct_domain}/{app_id}/" if direct_domain else "",
            "localUrl": f"https://{local_ip}/{app_id}/" if local_ip else "",
            "cloudUrl": f"https://unifi.ui.com/consoles/{hid}/{app_id}/" if hid else "",
        })

    for a in raw_apps:
        if not isinstance(a, dict):
            continue
        app_id = model_string(a.get("name", "")).lower()
        if not app_id or app_id in seen_app_ids:
            continue
        seen_app_ids.add(app_id)
        ver = model_string(a.get("version") or a.get("uiVersion") or "")
        apps_list.append({
            "id": app_id,
            "name": app_display_names.get(app_id, f"UniFi {app_id.capitalize()}"),
            "version": ver or "Installed",
            "state": "active",
            "isRunning": True,
            "isInstalled": True,
            "updatable": False,
            "updateAvailable": "",
            "port": 0,
            "icon": app_icons.get(app_id, "cube"),
            "directUrl": f"https://{direct_domain}/{app_id}/" if direct_domain else "",
            "localUrl": f"https://{local_ip}/{app_id}/" if local_ip else "",
            "cloudUrl": f"https://unifi.ui.com/consoles/{hid}/{app_id}/" if hid else "",
        })

    uidb = rep.get("uidb") if isinstance(rep.get("uidb"), dict) else {}
    images = uidb.get("images") if isinstance(uidb.get("images"), dict) else {}

    return {
        "hostId": hid,
        "name": h_name,
        "siteName": site_name or h_name,
        "model": model_name,
        "shortModel": model_string(hw.get("shortname", "")),
        "mac": mac,
        "ip": local_ip,
        "firmwareVersion": firmware,
        "isOnline": is_online,
        "directConnectDomain": direct_domain,
        "directConnectUrl": direct_url,
        "directConnectStatus": "Active (P2P WebRTC Direct)" if (direct_domain and is_online) else ("Unavailable" if not direct_domain else "Console Offline"),
        "webCloudUrl": web_url,
        "localUrl": local_url,
        "activeAppCount": sum(1 for a in apps_list if a["isRunning"]),
        "applications": apps_list,
        "uidbImages": images,
    }


def extract_telemetry_details(
    key: str, raw_hosts: list[dict[str, Any]], sites: list[dict[str, Any]]
) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[dict[str, Any]], list[dict[str, Any]], list[dict[str, Any]]]:
    wans: list[dict[str, Any]] = []
    outages: list[dict[str, Any]] = []
    site_map: dict[str, str] = {s.get("hostId", ""): s.get("name", "Site") for s in sites}
    gw_models: dict[str, str] = {s.get("hostId", ""): s.get("gatewayModel", "") for s in sites}
    isps: dict[str, str] = {s.get("hostId", ""): s.get("isp", "") for s in sites}
    consoles: list[dict[str, Any]] = [
        compact_console(host, site_map.get(model_string(first_value(host, "id", "hostId"), max_length=256), ""))
        for host in raw_hosts
    ]

    for host in raw_hosts:
        hid = model_string(first_value(host, "id", "hostId"), max_length=256)
        sname = site_map.get(hid, "Site")
        rep = host.get("reportedState") if isinstance(host.get("reportedState"), dict) else {}
        host_wans = rep.get("wans")
        if isinstance(host_wans, list):
            for idx, w in enumerate(host_wans):
                if not isinstance(w, dict):
                    continue
                w_type = model_string(w.get("type", "WAN"))
                is_pri = w_type == "WAN" or idx == 0
                wans.append({
                    "siteName": sname,
                    "hostId": hid,
                    "gatewayModel": gw_models.get(hid) or "Gateway",
                    "name": "WAN 1 (Primary)" if is_pri else f"WAN {idx + 1} (Failover)",
                    "interface": model_string(w.get("interface", f"eth{w.get('port', 0)}")),
                    "port": int(w.get("port", 0)),
                    "speedType": model_string(w.get("speedType", "1GbE")),
                    "plugged": bool(w.get("plugged", False)),
                    "enabled": bool(w.get("enabled", True)),
                    "type": "Primary WAN" if is_pri else "Backup / Failover WAN",
                    "ipv4": model_string(w.get("ipv4", "")),
                    "ipv6": model_string(w.get("ipv6", "")),
                    "isp": isps.get(hid) or "Fiber / Broadband",
                    "mac": model_string(w.get("mac", "")),
                    "uptime": "100%" if w.get("plugged") else "Offline",
                })

        issues_data = rep.get("internetIssues5min")
        if isinstance(issues_data, dict):
            periods = issues_data.get("periods")
            if isinstance(periods, list):
                for p in periods:
                    if isinstance(p, dict) and "index" in p:
                        ts = int(p["index"]) * 300
                        time_str = datetime.datetime.fromtimestamp(ts, datetime.timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
                        outages.append({
                            "siteName": sname,
                            "timestamp": ts,
                            "timeText": time_str,
                            "durationMinutes": 5,
                            "durationText": "5m",
                            "type": "Internet Outage",
                            "description": "Gateway internet link dropped (packet loss detected)",
                            "severity": "critical",
                        })

    outages.sort(key=lambda o: o["timestamp"], reverse=True)

    online_hosts = [h for h in raw_hosts if host_is_online(h) and first_value(h, "id", "hostId")]
    tasks: list[tuple[str, str]] = []
    for h in online_hosts:
        hid = model_string(first_value(h, "id", "hostId"), max_length=256)
        tasks.append((hid, "/network/api/s/default/stat/sta"))
        tasks.append((hid, "/network/api/s/default/stat/device"))

    def fetch_stat(item: tuple[str, str]) -> tuple[str, str, int, list[dict[str, Any]]]:
        hid, path = item
        try:
            status, res = cloud_json_request(key, connector_path(hid, path))
            data = res.get("data", []) if (status == 200 and isinstance(res, dict)) else []
            return hid, path, status, data if isinstance(data, list) else []
        except Exception:
            return hid, path, 500, []

    host_stas: dict[str, list[dict[str, Any]]] = {}
    host_devs: dict[str, list[dict[str, Any]]] = {}

    if tasks:
        with ThreadPoolExecutor(max_workers=min(8, len(tasks))) as ex:
            for hid, path, status, items in ex.map(fetch_stat, tasks):
                if "stat/sta" in path:
                    host_stas[hid] = items
                else:
                    host_devs[hid] = items

    clients: list[dict[str, Any]] = []
    switches: list[dict[str, Any]] = []

    for hid, raw_sta_list in host_stas.items():
        sname = site_map.get(hid, "Site")
        dev_list = host_devs.get(hid, [])
        ap_names: dict[str, str] = {
            d.get("mac", "").lower(): d.get("name") or d.get("model") or "UniFi AP"
            for d in dev_list if isinstance(d, dict) and d.get("mac")
        }
        sw_names: dict[str, str] = {
            d.get("mac", "").lower(): d.get("name") or d.get("model") or "UniFi Switch"
            for d in dev_list if isinstance(d, dict) and d.get("mac")
        }

        for c in raw_sta_list:
            if not isinstance(c, dict):
                continue
            is_wired = bool(c.get("is_wired"))
            c_name = model_string(first_value(c, "name", "hostname", "ip", "mac", default="Client"))
            c_host = model_string(c.get("hostname", ""))
            c_ip = model_string(c.get("ip", ""))
            c_mac = model_string(c.get("mac", ""))
            c_channel = int(c.get("channel") or 0)
            c_signal = int(c.get("signal") or 0)
            c_proto = model_string(c.get("radio_proto", ""))
            if c_proto == "be":
                proto_text = "WiFi 7 (be)"
            elif c_proto == "ax":
                proto_text = "WiFi 6 (ax)"
            elif c_proto == "ac":
                proto_text = "WiFi 5 (ac)"
            elif c_proto == "ng":
                proto_text = "WiFi 4 (ng)"
            elif is_wired:
                proto_text = f"Wired ({c.get('wired_rate_mbps', 1000)}M)"
            else:
                proto_text = c_proto or "Wireless"

            band_text = "Ethernet" if is_wired else ("2.4 GHz" if c_channel <= 14 else ("5 GHz" if c_channel <= 177 else "6 GHz"))
            uptime_sec = int(c.get("uptime") or 0)
            rx_b = int(c.get("rx_bytes") or 0)
            tx_b = int(c.get("tx_bytes") or 0)
            rx_r = round(float(c.get("rx_rate") or 0) / 1000.0, 1) if not is_wired else float(c.get("wired_rate_mbps") or 1000)
            tx_r = round(float(c.get("tx_rate") or 0) / 1000.0, 1) if not is_wired else float(c.get("wired_rate_mbps") or 1000)

            ap_mac = model_string(c.get("ap_mac", "")).lower()
            sw_mac = model_string(c.get("sw_mac", "")).lower()
            uplink_name = ap_names.get(ap_mac, "Access Point") if not is_wired else sw_names.get(sw_mac, "Switch")
            uplink_port = f"Ch {c_channel}" if not is_wired else f"Port {c.get('sw_port', 1)}"

            clients.append({
                "name": c_name,
                "hostname": c_host,
                "ip": c_ip,
                "mac": c_mac,
                "siteName": sname,
                "isWired": is_wired,
                "essid": model_string(c.get("essid", "")),
                "apMac": ap_mac,
                "apName": ap_names.get(ap_mac, ""),
                "channel": c_channel,
                "band": band_text,
                "signal": c_signal,
                "radioProto": proto_text,
                "rxRate": rx_r,
                "txRate": tx_r,
                "rxBytes": rx_b,
                "txBytes": tx_b,
                "uptime": uptime_sec,
                "uptimeText": format_uptime(uptime_sec),
                "uplinkName": uplink_name,
                "uplinkPort": uplink_port,
                "uplinkSpeed": rx_r,
            })

    for hid, dev_list in host_devs.items():
        sname = site_map.get(hid, "Site")
        sta_list = host_stas.get(hid, [])
        wired_port_clients: dict[tuple[str, int], str] = {}
        for c in sta_list:
            if isinstance(c, dict) and c.get("is_wired") and c.get("sw_mac") and c.get("sw_port"):
                key_pair = (model_string(c["sw_mac"]).lower(), int(c["sw_port"]))
                wired_port_clients[key_pair] = model_string(first_value(c, "name", "hostname", "ip", default="Client"))

        downlink_devs: dict[tuple[str, int], str] = {}
        for d in dev_list:
            if isinstance(d, dict) and d.get("uplink"):
                up_dict = d["uplink"]
                if isinstance(up_dict, dict) and up_dict.get("uplink_mac") and up_dict.get("uplink_remote_port"):
                    pair = (model_string(up_dict["uplink_mac"]).lower(), int(up_dict["uplink_remote_port"]))
                    downlink_devs[pair] = model_string(first_value(d, "name", "model", default="Device"))

        for d in dev_list:
            if not isinstance(d, dict):
                continue
            port_table = d.get("port_table")
            if not isinstance(port_table, list) or not port_table:
                continue
            sw_name = model_string(first_value(d, "name", "model", default="Switch"))
            sw_model = model_string(first_value(d, "model", default="USW"))
            sw_mac = model_string(d.get("mac", "")).lower()
            sw_ip = model_string(d.get("ip", ""))

            ports: list[dict[str, Any]] = []
            total_pwr = 0.0
            poe_count = 0
            active_count = 0

            for p in port_table:
                if not isinstance(p, dict):
                    continue
                pidx = int(p.get("port_idx") or 0)
                is_up = bool(p.get("up"))
                if is_up:
                    active_count += 1
                spd = int(p.get("speed") or 0)
                spd_str = f"{spd // 1000} GbE" if spd >= 1000 else (f"{spd} FE" if spd > 0 else "Disconnected")
                poe_mode = model_string(p.get("poe_mode", "off"))
                try:
                    pwr = float(p.get("poe_power") or 0.0)
                except (ValueError, TypeError):
                    pwr = 0.0
                try:
                    volts = float(p.get("poe_voltage") or 0.0)
                except (ValueError, TypeError):
                    volts = 0.0
                try:
                    curr = float(p.get("poe_current") or 0.0)
                except (ValueError, TypeError):
                    curr = 0.0

                if p.get("port_poe") or poe_mode != "off" or pwr > 0:
                    poe_count += 1
                    total_pwr += pwr

                c_dev = downlink_devs.get((sw_mac, pidx)) or wired_port_clients.get((sw_mac, pidx)) or ""

                ports.append({
                    "portIdx": pidx,
                    "name": model_string(p.get("name") or f"Port {pidx}"),
                    "up": is_up,
                    "speed": spd,
                    "speedText": spd_str,
                    "poeMode": poe_mode,
                    "poePower": round(pwr, 2),
                    "poeVoltage": round(volts, 2),
                    "poeCurrent": round(curr, 1),
                    "connectedDevice": c_dev,
                })

            max_pwr = float(d.get("total_max_power") or (600.0 if "48" in sw_model else (60.0 if "Ultra" in sw_name else 120.0)))

            switches.append({
                "name": sw_name,
                "model": sw_model,
                "mac": sw_mac,
                "ip": sw_ip,
                "siteName": sname,
                "hostId": hid,
                "totalPorts": len(ports),
                "poePorts": poe_count,
                "activePorts": active_count,
                "totalPower": round(total_pwr, 2),
                "maxPower": max_pwr,
                "ports": ports,
            })

    return wans, outages, clients, switches, consoles


def build_cloud_summary(key: str) -> dict[str, Any]:
    raw_sites = cloud_rows(key, "/v1/sites")
    if len(raw_sites) > MAX_MODEL_ITEMS:
        raise FabricError("UniFi Site Manager returned too many sites")
    try:
        raw_hosts = cloud_rows(key, "/v1/hosts")
    except FabricError:
        raw_hosts = []
    try:
        raw_groups = cloud_rows(key, "/v1/devices")
    except FabricError:
        raw_groups = []

    host_names: dict[str, str] = {}
    host_online = {
        model_string(first_value(host, "id", "hostId"), max_length=256): host_is_online(host)
        for host in raw_hosts
        if first_value(host, "id", "hostId")
    }
    flattened: list[dict[str, Any]] = []
    for group in raw_groups:
        host_id = model_string(first_value(group, "hostId", "id"), max_length=256)
        host_name = model_string(first_value(group, "hostName", "name"))
        if host_id and host_name:
            host_names[host_id] = host_name
        members = group.get("devices")
        if isinstance(members, list):
            for member in members:
                if isinstance(member, dict):
                    copy = dict(member)
                    copy.setdefault("hostId", host_id)
                    copy.setdefault("hostName", host_name)
                    flattened.append(copy)
        else:
            flattened.append(group)
        if len(flattened) > MAX_MODEL_ITEMS:
            raise FabricError("UniFi Site Manager returned too many devices")

    sites: list[dict[str, Any]] = []
    total_devices = total_clients = total_offline = total_updates = 0
    for item in raw_sites:
        meta = item.get("meta") if isinstance(item.get("meta"), dict) else {}
        stats = item.get("statistics") if isinstance(item.get("statistics"), dict) else {}
        counts = stats.get("counts") if isinstance(stats.get("counts"), dict) else {}
        percentages = stats.get("percentages") if isinstance(stats.get("percentages"), dict) else {}
        isp_info = stats.get("ispInfo") if isinstance(stats.get("ispInfo"), dict) else {}
        host_id = model_string(first_value(item, "hostId"), max_length=256)
        raw_name = model_string(first_value(meta, "desc", "name", default="Site"))
        name = host_names.get(host_id, raw_name) if raw_name.lower() == "default" else raw_name
        device_count = int(nested_number(counts, "totalDevice"))
        client_count = int(sum(nested_number(counts, key) for key in ("wifiClient", "wiredClient", "guestClient")))
        wifi_count = int(nested_number(counts, "wifiClient"))
        wired_count = int(nested_number(counts, "wiredClient"))
        offline_count = int(nested_number(counts, "offlineDevice"))
        update_count = int(nested_number(counts, "pendingUpdateDevice"))
        total_devices += device_count
        total_clients += client_count
        total_offline += offline_count
        total_updates += update_count
        status, status_text = site_health(stats, counts)
        if host_id in host_online and not host_online[host_id]:
            status, status_text = "down", "Site unreachable"
        lat, lng = site_coordinates(meta, model_string(first_value(meta, "timezone"), max_length=128), len(sites))

        site_devs = [
            d for d in flattened
            if model_string(first_value(d, "hostId", "id"), max_length=256) == host_id
            or model_string(first_value(d, "hostName", "name")) == name
            or str(d.get("site", "")).casefold() == name.casefold()
        ]
        gw_item = next(
            (d for d in site_devs if any(k in str(d.get("model", "")).lower() for k in ("udm", "ucg", "uxg", "gateway", "usg"))),
            None
        )
        gw_model = model_string(first_value(gw_item, "model", "shortname", "type")) if gw_item else ""
        gw_ip = model_string(first_value(gw_item, "ipAddress", "ip", "lanIp"), max_length=64) if gw_item else ""

        sites.append({
            "id": model_string(first_value(item, "siteId", "id"), max_length=128),
            "hostId": host_id,
            "name": name,
            "isp": model_string(first_value(isp_info, "name", "organization")),
            "timezone": model_string(first_value(meta, "timezone"), max_length=128),
            "lat": lat,
            "lng": lng,
            "gatewayModel": gw_model,
            "gatewayIp": gw_ip,
            "deviceCount": device_count,
            "clientCount": client_count,
            "wifiClients": wifi_count,
            "wiredClients": wired_count,
            "offlineCount": offline_count,
            "updateCount": update_count,
            "wanUptime": nested_number(percentages, "wanUptime"),
            "permission": model_string(first_value(item, "permission", default="viewer"), max_length=64),
            "owner": bool(item.get("isOwner", False)),
            "status": status,
            "statusText": status_text,
        })

    sites.sort(key=site_sort_key)

    devices = [compact_device(item) | {"site": model_string(first_value(item, "hostName"))} for item in flattened]
    camera_words = ("camera", "protect", "doorbell", "ai pro", "g3", "g4", "g5", "uvc")
    camera_items = [
        item for item in flattened
        if any(word in " ".join(str(value).lower() for value in item.values() if isinstance(value, (str, int))) for word in camera_words)
    ]
    cameras = [compact_camera(item) for item in camera_items]
    if not total_devices and devices:
        total_devices = len(devices)
        total_offline = sum(not item["online"] for item in devices)
        total_updates = sum(item["update"] for item in devices)

    down_sites = sum(item["status"] == "down" for item in sites)
    backup_sites = sum(item["status"] == "backup" for item in sites)
    if down_sites:
        severity, message = "critical", f"{down_sites} site(s) unreachable"
    elif backup_sites:
        severity, message = "warning", f"{backup_sites} site(s) using backup WAN"
    elif total_offline:
        severity, message = "critical", f"{total_offline} device(s) offline across {len(sites)} sites"
    elif total_updates:
        severity, message = "warning", f"{total_updates} firmware update(s) across {len(sites)} sites"
    else:
        severity, message = "healthy", f"All {len(sites)} sites operational"

    total_wifi = sum(s.get("wifiClients", 0) for s in sites)
    total_wired = sum(s.get("wiredClients", 0) for s in sites)
    total_gateways = sum(bool(s.get("gatewayModel")) for s in sites)
    issues = track_issues(sites, devices, is_demo=False)
    sdwan = get_sdwan_telemetry(key)
    try:
        wans, outages, clients, switches, consoles = extract_telemetry_details(key, raw_hosts, sites)
    except Exception:
        wans, outages, clients, switches, consoles = [], [], [], [], []

    return {
        "ok": True,
        "connected": True,
        "mode": "cloud",
        "baseUrl": "https://unifi.ui.com",
        "host": "unifi.ui.com",
        "site": f"{len(sites)} site" + ("" if len(sites) == 1 else "s"),
        "sites": sites,
        "severity": severity,
        "message": message,
        "network": {
            "available": True,
            "devices": devices,
            "deviceCount": total_devices,
            "offlineCount": total_offline,
            "updateCount": total_updates,
            "clientCount": total_clients,
            "wifiClients": total_wifi,
            "wiredClients": total_wired,
            "gatewaysCount": total_gateways,
        },
        "protect": {"available": bool(cameras), "cameras": cameras, "cameraCount": len(cameras), "offlineCount": sum(not item["online"] for item in cameras)},
        "issues": issues,
        "sdwan": sdwan,
        "wans": wans,
        "outages": outages,
        "clients": clients,
        "switches": switches,
        "consoles": consoles,
    }


def build_cloud_site(key: str, host_id: str, site_id: str) -> dict[str, Any]:
    if not ID_PATTERN.fullmatch(site_id):
        raise FabricError("Invalid UniFi site id")

    site_status, sites_payload = cloud_json_request(key, connector_path(host_id, "/network/integration/v1/sites"))
    if site_status != 200:
        raise FabricError(f"This site's Network application is unavailable (HTTP {site_status})")
    network_sites = rows(sites_payload)
    chosen = next(
        (item for item in network_sites if model_string(first_value(item, "id", "siteId", "_id"), max_length=128) == site_id),
        network_sites[0] if len(network_sites) == 1 else None,
    )
    if not chosen:
        raise FabricError("UniFi Cloud Connector could not match this Network site")
    local_site_id = model_string(first_value(chosen, "id", "siteId", "_id"), max_length=128)
    if not ID_PATTERN.fullmatch(local_site_id):
        raise FabricError("The console returned an invalid Network site id")

    device_status, device_payload = cloud_json_request(
        key, connector_path(host_id, f"/network/integration/v1/sites/{local_site_id}/devices")
    )
    client_status, client_payload = cloud_json_request(
        key, connector_path(host_id, f"/network/integration/v1/sites/{local_site_id}/clients")
    )
    stat_status, stat_payload = cloud_json_request(
        key, connector_path(host_id, "/network/api/s/default/stat/device")
    )
    uplinks: dict[str, dict[str, Any]] = {}
    if stat_status == 200 and isinstance(stat_payload, dict):
        for item in stat_payload.get("data", []):
            if isinstance(item, dict):
                mac = str(item.get("mac", "")).lower().replace(":", "")
                up = item.get("uplink") if isinstance(item.get("uplink"), dict) else {}
                uplinks[mac] = {
                    "parentName": up.get("uplink_device_name", ""),
                    "parentMac": up.get("uplink_mac", ""),
                    "parentPort": int(up.get("uplink_remote_port") or up.get("port_idx") or 0),
                    "uplinkSpeed": int(up.get("speed") or 0),
                    "uplinkMedia": str(up.get("media") or ""),
                }

    raw_devices = rows(device_payload) if device_status == 200 else []
    devices = []
    for item in raw_devices:
        mac = str(first_value(item, "macAddress", "mac", default="")).lower().replace(":", "")
        up_data = uplinks.get(mac, {})
        enriched = dict(item) | up_data
        devices.append(compact_device(enriched))
    clients = rows(client_payload) if client_status == 200 else []

    protect_status, protect_payload = cloud_json_request(
        key, connector_path(host_id, "/protect/integration/v1/cameras")
    )
    protect_installed = protect_status == 200
    cameras = [compact_camera(item) for item in rows(protect_payload)] if protect_installed else []
    offline_devices = sum(not item["online"] for item in devices)
    offline_cameras = sum(not item["online"] for item in cameras)
    updates = sum(item["update"] for item in devices)

    console_data: dict[str, Any] = {}
    try:
        host_status, host_payload = cloud_json_request(key, f"/v1/hosts/{host_id}")
        if host_status == 200 and isinstance(host_payload, dict) and isinstance(host_payload.get("data"), dict):
            console_data = compact_console(host_payload["data"], model_string(first_value(chosen, "name", "displayName", default="UniFi site")))
    except Exception:
        pass

    return {
        "ok": True,
        "connected": True,
        "mode": "cloud-site",
        "hostId": host_id,
        "siteId": site_id,
        "site": {
            "id": local_site_id,
            "name": model_string(first_value(chosen, "name", "displayName", default="UniFi site")),
        },
        "network": {
            "available": True,
            "devices": devices,
            "deviceCount": len(devices),
            "offlineCount": offline_devices,
            "updateCount": updates,
            "clientCount": len(clients),
        },
        "protect": {
            "installed": protect_installed,
            "available": protect_installed,
            "cameras": cameras,
            "cameraCount": len(cameras),
            "offlineCount": offline_cameras,
        },
        "console": console_data,
    }


def build_summary(config: dict[str, Any], key: str) -> dict[str, Any]:
    network_status, sites_payload = json_request(config, key, "/proxy/network/integration/v1/sites")
    protect_status, cameras_payload = json_request(config, key, "/proxy/protect/integration/v1/cameras")

    sites = rows(sites_payload) if network_status == 200 else []
    site = sites[0] if sites else {}
    site_id = model_string(first_value(site, "id", "siteId", "_id"), max_length=128)
    devices: list[dict[str, Any]] = []
    clients: list[dict[str, Any]] = []
    if site_id:
        device_status, device_payload = json_request(config, key, f"/proxy/network/integration/v1/sites/{site_id}/devices")
        client_status, client_payload = json_request(config, key, f"/proxy/network/integration/v1/sites/{site_id}/clients")
        if device_status == 200:
            devices = [compact_device(item) for item in rows(device_payload)]
        if client_status == 200:
            clients = rows(client_payload)

    cameras = [compact_camera(item) for item in rows(cameras_payload)] if protect_status == 200 else []
    offline_devices = sum(not item["online"] for item in devices)
    offline_cameras = sum(not item["online"] for item in cameras)
    updates = sum(item["update"] for item in devices)

    available_apps = int(network_status == 200) + int(protect_status == 200)
    if available_apps == 0:
        raise FabricError("The API key was accepted by neither Network nor Protect")
    if offline_devices + offline_cameras:
        severity, message = "critical", f"{offline_devices + offline_cameras} device(s) offline"
    elif available_apps < 2:
        severity, message = "warning", "One UniFi application is unavailable"
    elif updates:
        severity, message = "warning", f"{updates} firmware update(s) available"
    else:
        severity, message = "healthy", "All systems operational"

    local_host = config.get("hostname") or "unifi.local"
    local_consoles = [{
        "hostId": "local-gateway",
        "name": model_string(site.get("name") or "Local Gateway"),
        "siteName": model_string(site.get("name") or "Default"),
        "model": "UniFi OS Console",
        "shortModel": "Gateway",
        "mac": "",
        "ip": local_host,
        "firmwareVersion": "",
        "isOnline": True,
        "directConnectDomain": "",
        "directConnectUrl": f"https://{local_host}",
        "directConnectStatus": "Local Direct HTTPS",
        "webCloudUrl": "https://unifi.ui.com",
        "localUrl": f"https://{local_host}",
        "activeAppCount": 1 + int(protect_status == 200),
        "applications": [
            {
                "id": "network",
                "name": "UniFi Network",
                "version": "Connected",
                "state": "active",
                "isRunning": True,
                "isInstalled": True,
                "updatable": False,
                "updateAvailable": "",
                "port": 443,
                "icon": "network",
                "directUrl": f"https://{local_host}/network/",
                "localUrl": f"https://{local_host}/network/",
                "cloudUrl": "",
            }
        ] + ([{
            "id": "protect",
            "name": "UniFi Protect",
            "version": "Connected",
            "state": "active",
            "isRunning": True,
            "isInstalled": True,
            "updatable": False,
            "updateAvailable": "",
            "port": 443,
            "icon": "video",
            "directUrl": f"https://{local_host}/protect/",
            "localUrl": f"https://{local_host}/protect/",
            "cloudUrl": "",
        }] if protect_status == 200 else []),
        "uidbImages": {},
    }]

    return {
        "ok": True,
        "connected": True,
        "baseUrl": config["baseUrl"],
        "host": config["hostname"],
        "site": model_string(first_value(site, "name", "displayName", default="Default")),
        "severity": severity,
        "message": message,
        "network": {
            "available": network_status == 200,
            "devices": devices,
            "deviceCount": len(devices),
            "offlineCount": offline_devices,
            "updateCount": updates,
            "clientCount": len(clients),
        },
        "protect": {
            "available": protect_status == 200,
            "cameras": cameras,
            "cameraCount": len(cameras),
            "offlineCount": offline_cameras,
        },
        "issues": track_issues([], devices, is_demo=False),
        "sdwan": {"available": False, "status": "none"},
        "wans": [],
        "outages": [],
        "clients": clients,
        "switches": [],
        "consoles": local_consoles,
    }


def command_clear_history() -> None:
    if ISSUES_FILE.is_file():
        try:
            raw = decode_json(ISSUES_FILE.read_text(encoding="utf-8"))
            if isinstance(raw, list):
                active = [i for i in raw if isinstance(i, dict) and i.get("active")]
                ISSUES_FILE.write_text(json.dumps(active, separators=(",", ":")), encoding="utf-8")
        except Exception:
            ISSUES_FILE.unlink(missing_ok=True)
    emit({"ok": True, "cleared": True})


def command_probe(raw_host: str) -> None:
    base_url, hostname, port = normalize_host(raw_host)
    pem = fetch_certificate(hostname, port)
    fingerprint, spki = certificate_identity(pem)
    saved = read_config()
    emit({
        "ok": True,
        "baseUrl": base_url,
        "host": hostname,
        "port": port,
        "fingerprint": fingerprint,
        "trusted": bool(saved and saved.get("spki") == spki),
    })


def command_connect(raw_host: str, accepted_fingerprint: str) -> None:
    key = sys.stdin.readline().strip()
    if not KEY_PATTERN.fullmatch(key):
        fail("Enter a valid UniFi API key")
    base_url, hostname, port = normalize_host(raw_host)
    pem = fetch_certificate(hostname, port)
    fingerprint, spki = certificate_identity(pem)
    if fingerprint != accepted_fingerprint.strip().upper():
        fail("The console certificate changed; inspect it again before connecting")
    candidate = {
        "baseUrl": base_url,
        "hostname": hostname,
        "port": port,
        "fingerprint": fingerprint,
        "spki": spki,
    }
    # Validate before persisting either the connection or the credential.
    try:
        summary = build_summary(candidate, key)
    except FabricError as exc:
        fail(str(exc))
    secret_store(key)
    write_config(candidate)
    summary["authenticated"] = True
    emit(summary)


def command_connect_cloud() -> None:
    key = sys.stdin.readline().strip()
    if not KEY_PATTERN.fullmatch(key):
        fail("Enter a valid UI Account API key")
    try:
        summary = build_cloud_summary(key)
    except FabricError as exc:
        fail(str(exc))
    secret_store(key)
    write_config({"mode": "cloud", "baseUrl": "https://api.ui.com"})
    summary["authenticated"] = True
    emit(summary)


def command_summary(demo: bool) -> None:
    if demo:
        emit(demo_summary())
    config = read_config()
    key = secret_lookup()
    if not config or not key:
        fail("Connect UniFi SiteThread to your UI Account", connected=False)
    try:
        emit(build_cloud_summary(key) if config.get("mode") == "cloud" else build_summary(config, key))
    except FabricError as exc:
        fail(str(exc), connected=True)


def command_site(host_id: str, site_id: str) -> None:
    config = read_config()
    key = secret_lookup()
    if not config or not key:
        fail("UniFi SiteThread is not connected", connected=False)
    if config.get("mode") != "cloud":
        fail("Site drill-down is available for UI Account connections")
    try:
        emit(build_cloud_site(key, host_id, site_id))
    except FabricError as exc:
        fail(str(exc), connected=True)


def command_snapshot(camera_id: str, host_id: str | None) -> None:
    if not ID_PATTERN.fullmatch(camera_id):
        fail("Invalid camera id")
    config = read_config()
    key = secret_lookup()
    if not config or not key:
        fail("UniFi SiteThread is not connected", connected=False)
    private_dir(RUNTIME_DIR)
    target = RUNTIME_DIR / f"camera-{camera_id}-{os.getpid()}.jpg"
    if config.get("mode") == "cloud":
        if not host_id:
            fail("A site is required for a cloud camera")
        status = cloud_file_request(
            key,
            connector_path(host_id, f"/protect/integration/v1/cameras/{camera_id}/snapshot"),
            target,
        )
    else:
        status, _ = api_request(config, key, f"/proxy/protect/integration/v1/cameras/{camera_id}/snapshot", output=target)
    if status != 200 or not target.exists() or target.stat().st_size == 0:
        target.unlink(missing_ok=True)
        fail(f"Snapshot failed (HTTP {status})")
    target.chmod(0o600)
    emit({"ok": True, "path": str(target)})


def command_disconnect() -> None:
    secret_clear()
    CONFIG_FILE.unlink(missing_ok=True)
    LEGACY_CONFIG_FILE.unlink(missing_ok=True)
    emit({"ok": True, "connected": False})


def command_power_cycle(host_id: str, mac: str, port_idx: int) -> None:
    if not MAC_PATTERN.fullmatch(mac):
        fail("Invalid MAC address")
    if port_idx < 1 or port_idx > 64:
        fail("Invalid port index")
    config = read_config()
    if config.get("demo"):
        emit({"ok": True, "message": f"Port {port_idx} on switch {mac} power-cycled successfully (demo)."})
        return
    key = secret_lookup()
    if config.get("mode") == "cloud":
        if not HOST_ID_PATTERN.fullmatch(host_id):
            fail("Invalid host id")
        status, payload = cloud_json_request(
            key,
            connector_path(host_id, "/network/api/s/default/cmd/devmgr"),
            method="POST",
            payload={"cmd": "power-cycle", "mac": mac.lower(), "port_idx": int(port_idx)},
        )
    else:
        status, body = api_request(
            config,
            key,
            "/proxy/network/api/s/default/cmd/devmgr",
            method="POST",
            payload={"cmd": "power-cycle", "mac": mac.lower(), "port_idx": int(port_idx)},
        )
        payload = decode_json(body) if isinstance(body, str) else {}
    if status != 200:
        fail(f"PoE power cycle failed (HTTP {status})")
    emit({"ok": True, "message": f"PoE power cycle initiated on port {port_idx} ({mac})."})


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="site-thread")
    sub = parser.add_subparsers(dest="command", required=True)
    probe = sub.add_parser("probe")
    probe.add_argument("host")
    connect = sub.add_parser("connect")
    connect.add_argument("host")
    connect.add_argument("fingerprint")
    sub.add_parser("connect-cloud")
    summary = sub.add_parser("summary")
    summary.add_argument("--demo", action="store_true")
    site = sub.add_parser("site")
    site.add_argument("host_id")
    site.add_argument("site_id")
    snapshot = sub.add_parser("snapshot")
    snapshot.add_argument("camera_id")
    snapshot.add_argument("host_id", nargs="?")
    power_cycle = sub.add_parser("power-cycle")
    power_cycle.add_argument("host_id")
    power_cycle.add_argument("mac")
    power_cycle.add_argument("port_idx", type=int)
    sub.add_parser("clear-history")
    sub.add_parser("disconnect")
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    try:
        if args.command == "probe":
            command_probe(args.host)
        elif args.command == "connect":
            command_connect(args.host, args.fingerprint)
        elif args.command == "connect-cloud":
            command_connect_cloud()
        elif args.command == "summary":
            command_summary(args.demo)
        elif args.command == "site":
            command_site(args.host_id, args.site_id)
        elif args.command == "snapshot":
            command_snapshot(args.camera_id, args.host_id)
        elif args.command == "power-cycle":
            command_power_cycle(args.host_id, args.mac, args.port_idx)
        elif args.command == "clear-history":
            command_clear_history()
        elif args.command == "disconnect":
            command_disconnect()
    except FabricError as exc:
        fail(str(exc))


if __name__ == "__main__":
    main()
